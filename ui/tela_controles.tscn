[node name="RegraMinirriff" type="Label" parent="Margens/Painel/Respiro/Coluna/Conteudo/Secoes"]
layout_mode = 2
text = "Complete em até 3,5 s. Erro ou tempo esgotado custa 1 poder e atordoa por 0,5 s."
autowrap_mode = 3

[node name="TituloTeclado" type="Label" parent="Margens/Painel/Respiro/Coluna/Conteudo/Secoes"]
layout_mode = 2
text = "Teclado"
theme_override_colors/font_color = Color(1, 0.43, 0.77, 1)
theme_override_font_sizes/font_size = 22

[node name="Teclado" type="Label" parent="Margens/Painel/Respiro/Coluna/Conteudo/Secoes"]
layout_mode = 2
text = "P1   WASD mover e tocar no Riff  •  F socar  •  G esquivar\n       Y interagir  •  T Riff  •  Esc pausar  •  R reiniciar\nP2   Setas mover e tocar no Riff  •  J socar, entrar e reiniciar  •  K esquivar\n       L interagir  •  I Riff  •  P pausar"
autowrap_mode = 3

[node name="TituloControle" type="Label" parent="Margens/Painel/Respiro/Coluna/Conteudo/Secoes"]
layout_mode = 2
text = "Controle Xbox"
theme_override_colors/font_color = Color(1, 0.43, 0.77, 1)
theme_override_font_sizes/font_size = 22

[node name="Controle" type="Label" parent="Margens/Painel/Respiro/Coluna/Conteudo/Secoes"]
layout_mode = 2
text = "Analógico ou direcional: mover  •  X socar  •  B esquivar  •  RB interagir\nA abre e fecha o Riff  •  Pistas: LT, LB, RB, RT da esquerda para a direita\nStart pausa ou reinicia  •  Num controle livre, Start chama o P2\nP1 e P2 trocam sozinhos entre teclado e controle: vale o último que tocar"
autowrap_mode = 3

[node name="Interacao" type="Label" parent="Margens/Painel/Respiro/Coluna/Conteudo/Secoes"]
layout_mode = 2
text = "Interaja para usar o portal. Segure o comando para levantar o parceiro."
autowrap_mode = 3

[node name="RiffIndependente" type="Label" parent="Margens/Painel/Respiro/Coluna/Conteudo/Secoes"]
layout_mode = 2
text = "Nos chefes, cada jogador abre o próprio Riff. P1 à esquerda, P2 à direita. Dano por acerto: 0,5× solo, 1× com os dois tocando. Esquivar também fecha o próprio Riff."
autowrap_mode = 3

[node name="Voltar" type="Button" parent="Margens/Painel/Respiro/Coluna"]
custom_minimum_size = Vector2(210, 44)
layout_mode = 2
size_flags_horizontal = 4
text = "Voltar"
